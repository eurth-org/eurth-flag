---
// Flagwright's 404: no flag flies here.
import Page from '@eurth/style/components/Page.astro';
import { site } from '../../eurth.config.mjs';
import Credits from '../components/Credits.astro';
import Flag from '../components/Flag.astro';
import type { Flag as FlagData } from '../flag/model';

// A white flag: the page surrenders.
const white: FlagData = { ratio: [2, 3], division: { type: 'bands', dir: 'h', bands: [{ color: '#ffffff', weight: 1 }] }, overlays: [] };
---

<Page site={site} title="Unclaimed territory" description="This page doesn't exist. No flag has been planted here yet: the maker, the templates, the guide and the glossary are elsewhere." noindex>
  <div class="eu-stack lost">
    <div class="white"><Flag flag={white} id="white" title="A plain white flag" /></div>
    <h1>Unclaimed territory</h1>
    <p class="eu-lead">No flag has been planted on this page. We surrender: it doesn't exist, or it moved.</p>
    <p><a class="eu-btn eu-btn--primary" href="/">Plant a flag</a></p>
  </div>

  <Credits slot="inspirations" />
</Page>

<style>
  .lost {
    align-items: center;
    padding-block: var(--space-8);
    text-align: center;
  }

  .white {
    width: calc(4 * var(--size-target));
    transform-origin: 0 50%;
    /* It waves twice and comes to rest; not at all for visitors who asked for calm. */
    animation: wave 2s ease-in-out 2;
  }

  @keyframes wave {
    50% {
      transform: skewY(-4deg) scaleX(0.96);
    }
  }
</style>
