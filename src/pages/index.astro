---
// The maker, and under it what search engines and newcomers both want: what it is, how to use
// it, and answers to the usual questions (also given to search engines as structured data).
import { faqPage, webApplication } from '@eurth/style/build';
import Line from '@eurth/style/components/Line.astro';
import Page from '@eurth/style/components/Page.astro';
import { lineCompass, lineGrid3, lineList } from '@eurth/style/line';
import { site } from '../../eurth.config.mjs';
import Credits from '../components/Credits.astro';
import Flag from '../components/Flag.astro';
import { emblems } from '../flag/emblems';
import { simpleLink } from '../flag/link';
import { fromSimple } from '../flag/simple';
import { templates } from '../flag/templates';
import Maker from '../ui/Maker.svelte';

const steps = [
  { name: 'Divide the field', text: 'Pick a layout: a plain field, two or three bands, stripes, quarters, a diagonal, rays. Then choose its colours from the flag palette, or any colour you like.' },
  { name: 'Add an overlay', text: 'Lay one bold shape over the field: a cross, a Nordic cross, a saltire, a canton, a hoist triangle, a border, a pall. Or leave the field as it is.' },
  { name: 'Choose a symbol', text: `Add a star, a sun, a crescent, a ring of stars, or one of ${emblems.length} emblems, from dragons and wheat to towers and anchors. Set its colour, place and size.` },
  { name: 'Check it and take it with you', text: 'The design check reads your flag the way a vexillologist would. Download it as SVG, PNG or WebP, copy the link (the link is the flag), or save it in your nation’s profile file.' },
];

const faq = [
  {
    q: 'Is Flagwright free?',
    a: 'Yes. There is no account, no watermark and no paid tier. It is open source, made by the Eurth worldbuilding community for anyone who needs a flag.',
  },
  {
    q: 'Who owns the flags I make?',
    a: 'You do. Flagwright keeps no copy and claims no rights. Use your flag in a wiki, a novel, a game, a tabletop campaign or on real cloth. Emblems from the library come from Font Awesome Free under CC BY 4.0, which asks for a credit; stars, suns, crescents and every plain shape carry no conditions at all.',
  },
  {
    q: 'What is the difference between simple and advanced mode?',
    a: 'Simple mode is four choices: a division, an overlay, a symbol and their colours. It is the quickest way to a good flag. Advanced mode opens the same flag layer by layer: any number of bands with their own widths, any number of shapes and emblems, each placed, sized and turned by hand or by number. Advanced starts from your simple design, so you can begin simple and refine.',
  },
  {
    q: 'Which formats can I download?',
    a: 'SVG, which stays sharp at any size and is what wikis such as IIWiki and Wikipedia prefer; and PNG or WebP at up to 3840 pixels wide, or in the sizes social sites like: link preview, square, portrait, story, pin and wide. You can also copy the picture, or copy a link that holds the whole design.',
  },
  {
    q: 'Can I use it for NationStates, IIWiki, D&D or my novel?',
    a: 'That is what it was made for. Flagwright comes from Eurth, a worldbuilding and roleplay community that began on NationStates in 2004. The SVG uploads straight to a wiki; the PNG suits a forum, a NationStates nation page or a campaign handout.',
  },
  {
    q: 'What makes a flag good?',
    a: 'Most flag people agree on five things: keep it simple, make it mean something, use two or three colours that contrast, leave out lettering and seals, and make it distinctive. The design check measures the parts that can be measured and tells you where your flag bends a rule. The guide explains each one with examples.',
  },
  {
    q: 'Which proportions should my flag have?',
    a: '2:3 (two high, three wide) is the most common and a safe choice. 1:2 is longer, in the British manner; 3:5 sits between them; 1:1 is square, like Switzerland. In advanced mode you can set any proportions.',
  },
  {
    q: 'Where is my flag saved?',
    a: 'In its link. The link holds the whole design, so copying the link is saving it: paste it into a forum post, a note or a bookmark. You can also download the picture, or save your nation as a profile file that the other Eurth tools can read. Flags once saved in the browser by an earlier version of Flagwright are no longer shown; their links still open them.',
  },
  {
    q: 'What is the profile file?',
    a: 'One small file, named after your nation and ending in .eurth.json, that carries a nation from one Eurth tool to the next. Flagwright writes the flag into it (its link, its description, the picture, its proportions and colours) and leaves everything else in the file exactly as it was. It is saved on your own device and sent nowhere.',
  },
  {
    q: 'Does it work offline, and on a phone?',
    a: 'Yes to both. After the first visit the site keeps a copy of itself on your device and opens without a connection. Everything runs in your browser, on a phone as well as a desk.',
  },
  {
    q: 'Do you keep my flags or track me?',
    a: 'No. There are no trackers, cookies or analytics, and no server that stores designs. Nothing is kept in your browser either. A flag lives in its link; copying the link is saving it.',
  },
];

const featureList = [
  'Simple mode: division, overlay, symbol and colours',
  'Advanced mode: unlimited bands and layers, placed by hand',
  `${emblems.length} emblems, plus stars, suns, crescents and rings of stars`,
  'Design check against the principles of good flag design',
  'A written description of every flag',
  'Download as SVG, PNG or WebP, in the sizes social sites use',
  'A link that holds the whole flag',
  'Nation profile file, shared with the other Eurth tools',
  'Works offline',
];
const picks = templates.slice(0, 6);
---

<Page site={site} jsonld={[webApplication(site, { featureList, screenshot: `${site.url}/og.png` }), faqPage(faq)]}>
  <div class="eu-stack">
    <header class="eu-stack intro">
      <p class="eu-kicker">Flagwright, by Eurth</p>
      <h1>Flag maker: design a flag for your country, city or cause</h1>
      <p class="eu-lead">
        Four choices in <strong>Simple</strong> mode, every layer by hand in <strong>Advanced</strong>. Free, in your browser, no account needed. Download as SVG or PNG.
      </p>
    </header>

    <!-- client:load draws the maker as real HTML first, then wakes it up. -->
    <Maker client:load siteName={site.name} siteUrl={site.url} />

    <section class="eu-prose">
      <h2 id="how">How to make a flag</h2>
      <ol>
        {steps.map((s) => <li><strong>{s.name}.</strong> {s.text}</li>)}
      </ol>
      <p>
        Want more control? Switch to <strong>Advanced</strong>: your simple flag opens as bands and layers you can move, resize, turn, restack and recolour one by one. Drag a layer on the flag, or type exact numbers.
      </p>
    </section>

    <section class="eu-stack">
      <h2 id="start">Start from a classic layout</h2>
      <ul class="picks">
        {
          picks.map((t) => (
            <li>
              <a class="eu-card" href={simpleLink(t.simple)}>
                <Flag flag={fromSimple(t.simple)} id={`pick-${t.id}`} title={t.name} />
                <span>{t.name}</span>
              </a>
            </li>
          ))
        }
      </ul>
      <p class="eu-row">
        <a class="eu-btn" href="/templates/"><Line icon={lineGrid3} /> All {templates.length} templates</a>
        <a class="eu-btn" href="/guide/"><Line icon={lineCompass} /> How to design a good flag</a>
        <a class="eu-btn" href="/glossary/"><Line icon={lineList} /> Flag terms explained</a>
      </p>
    </section>

    <section class="eu-prose">
      <h2 id="questions">Questions</h2>
      {
        faq.map((f) => (
          <details class="faq">
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))
      }
    </section>
  </div>

  <Credits slot="inspirations" />
</Page>

<style>
  .intro {
    gap: var(--space-2);
  }

  .picks {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(calc(3 * var(--size-target) + var(--space-6)), 1fr));
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .picks .eu-card {
    padding: var(--space-3);
    font: var(--type-label);
  }

  .faq {
    margin-top: 0;
    border-bottom: 1px solid var(--line);
  }

  .faq summary {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    min-height: var(--size-target);
    padding: var(--space-2) 0;
    font: var(--type-heading);
    cursor: pointer;
  }

  .faq summary::before {
    content: '+';
    flex: none;
    width: var(--space-4);
    color: var(--ink-muted);
    text-align: center;
  }

  .faq[open] summary::before {
    content: '−';
  }

  .faq summary::-webkit-details-marker {
    display: none;
  }

  .faq p {
    margin: 0 0 var(--space-4) var(--space-6);
  }
</style>
