---
// A Font Awesome Free icon as inline SVG at build time (no runtime script or webfont).
// `draw` measures the outline as 1, so CSS can draw it stroke by stroke, the way line-md does.
import type { IconDefinition } from '@fortawesome/free-solid-svg-icons';

interface Props {
  icon: IconDefinition;
  class?: string;
  /** An accessible name, when the icon stands alone. Without one it's decorative. */
  label?: string;
  draw?: boolean;
}
const { icon, class: cls, label, draw } = Astro.props;
const [w, h, , , path] = icon.icon;
const d = Array.isArray(path) ? path.join(' ') : path;
---

<svg
  class:list={['icon', cls]}
  viewBox={`0 0 ${w} ${h}`}
  width={(w / h).toFixed(3) + 'em'}
  height="1em"
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"><path fill="currentColor" d={d} pathLength={draw ? 1 : undefined}></path></svg
>
